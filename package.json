{
  "name": "@local/dshtoken",
  "version": "1.0.0",
  "private": true,
  "description": "DSH Token 统计：独立统计页（日期范围柱状图、按类别/APIKey/模型/会话拆分、CNY 估算花费、会话悬停明细）+ 对话底部用量控件跳转 + token_stats 模型工具。",
  "license": "MIT",
  "author": "rinttt233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinttt233/dshtoken.git"
  },
  "homepage": "https://github.com/rinttt233/dshtoken#readme",
  "bugs": {
    "url": "https://github.com/rinttt233/dshtoken/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "usage",
    "cost",
    "statistics"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "dist",
    "src",
    "scripts",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/host-selftest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
